<?xml version="1.0" encoding="utf-8"?>
<!-- Privileged permissions AARE uses when installed as a system app (tools/magisk). -->
<permissions>
    <privapp-permissions package="net.prototux.aare">
        <!-- Capture the phone's audio by usage (music, navigation voice), like Android Auto. -->
        <permission name="android.permission.MODIFY_AUDIO_ROUTING" />
        <permission name="android.permission.CAPTURE_AUDIO_OUTPUT" />
    </privapp-permissions>
</permissions>
